# RNDM environment configuration (placeholders only — fill in real values).
# Copy this file to ".env" and replace the values. NEVER commit real secrets.
#
# Each workspace package reads the variables it needs; a single root .env is
# sufficient for local development of both the web app and the backend.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
# Backend API port (NestJS)
PORT=3001
# Public base URL of the backend API (used for canonical/absolute URLs)
API_BASE_URL=http://localhost:3001
# Public base URL of the Next.js web app (used for CORS / redirects)
WEB_APP_URL=http://localhost:3000
# Comma-separated list of allowed CORS origins. NEVER use "*" in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Supabase (database + auth)
# ---------------------------------------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
# anon/public key — safe to expose to the browser (NEXT_PUBLIC_* on the web)
SUPABASE_ANON_KEY=your-supabase-anon-key
# service-role key — SERVER SIDE ONLY. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------------------------------------------------------------------------
# Web app (Next.js) — public values are prefixed with NEXT_PUBLIC_
# ---------------------------------------------------------------------------
# Public API URL the browser uses to reach the backend
NEXT_PUBLIC_API_URL=http://localhost:3001
# Public Supabase URL + anon key for client-side auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
